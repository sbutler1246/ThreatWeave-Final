  "units": {
    "u001": {
      "start": 1,
      "end": 81,
      "text": "Note: This advisory uses the MITRE ATT&CK® for Enterprise framework, version 17.",
      "line_start": 1
    },
    "u002": {
      "start": 82,
      "end": 240,
      "text": "See the MITRE ATT&CK Tactics and Techniques section of this advisory for a table of the threat actors’ activity mapped to MITRE ATT&CK tactics and techniques.",
      "line_start": 1
    },
    "u003": {
      "start": 241,
      "end": 255,
      "text": "Initial Access",
      "line_start": 241
    },
    "u004": {
      "start": 256,
      "end": 399,
      "text": "The Play ransomware group gains initial access to victim networks through the abuse of valid accounts, likely purchased on the dark web [T1078]",
      "line_start": 256
    },
    "u005": {
      "start": 401,
      "end": 455,
      "text": "and exploitation of public-facing applications [T1190]",
      "line_start": 256
    },
    "u006": {
      "start": 457,
      "end": 619,
      "text": "specifically through known FortiOS (CVE-2018-13379 and CVE-2020-12812) and Microsoft Exchange (ProxyNotShell [CVE-2022-41040 and CVE-2022-41082]) vulnerabilities.",
      "line_start": 256
    },
    "u007": {
      "start": 620,
      "end": 793,
      "text": "Play ransomware actors have been observed using external-facing services [T1133] such as Remote Desktop Protocol (RDP) and Virtual Private Networks (VPN) for initial access.",
      "line_start": 256
    },
    "u008": {
      "start": 794,
      "end": 814,
      "text": "Update June 4, 2025:",
      "line_start": 794
    },
    "u009": {
      "start": 815,
      "end": 1141,
      "text": "Multiple ransomware groups, including initial access brokers with ties to Play ransomware operators, exploited CVE-2024-57727 in remote monitoring and management (RMM) tool SimpleHelp [T1190] to conduct remote code execution [T1059.001] at many U.S.-based entities following the vulnerabilities’ disclosure on 16 January 2025.",
      "line_start": 815
    },
    "u010": {
      "start": 1142,
      "end": 1152,
      "text": "End Update",
      "line_start": 1142
    },
    "u011": {
      "start": 1153,
      "end": 1182,
      "text": "Discovery and Defense Evasion",
      "line_start": 1153
    },
    "u012": {
      "start": 1183,
      "end": 1392,
      "text": "Play ransomware actors use tools like AdFind to run Active Directory queries [TA0007] and Grixba,1 an information-stealer, to enumerate network information [T1016] and scan for anti-virus software [T1518.001].",
      "line_start": 1183
    },
    "u013": {
      "start": 1393,
      "end": 1523,
      "text": "Actors also use tools like GMER, IOBit, and PowerTool to disable anti-virus software [T1562.001] and remove log files [T1070.001].",
      "line_start": 1183
    },
    "u014": {
      "start": 1524,
      "end": 1661,
      "text": "In some instances, cybersecurity researchers have observed Play ransomware actors using PowerShell scripts to target Microsoft Defender.2",
      "line_start": 1183
    },
    "u015": {
      "start": 1662,
      "end": 1692,
      "text": "Lateral Movement and Execution",
      "line_start": 1662
    },
    "u016": {
      "start": 1693,
      "end": 1870,
      "text": "Play ransomware actors use command and control (C2) applications, including Cobalt Strike and SystemBC, and tools like PsExec to assist with lateral movement and file execution.",
      "line_start": 1693
    },
    "u017": {
      "start": 1871,
      "end": 2048,
      "text": "Once established on a network, the ransomware actors search for unsecured credentials [T1552] and use the Mimikatz credential dumper to gain domain administrator access [T1003].",
      "line_start": 1693
    },
    "u018": {
      "start": 2049,
      "end": 2266,
      "text": "According to open source reporting,3 to further enumerate vulnerabilities, Play ransomware actors use Windows Privilege Escalation Awesome Scripts (WinPEAS) [T1059] to search for additional privilege escalation paths.",
      "line_start": 1693
    },
    "u019": {
      "start": 2267,
      "end": 2347,
      "text": "Actors then distribute executables [T1570] via Group Policy Objects [T1484.001].",
      "line_start": 1693
    }
  },
