    "u037": {
      "start": 1386,
      "end": 1439,
      "text": "Common Vulnerabilities and Exposures (CVEs) Exploited",
      "line_start": 1386
    },
    "u038": {
      "start": 1440,
      "end": 1659,
      "text": "Based on secondary sources, it was noted that affiliates exploit older vulnerabilities like CVE-2021-22986, F5 iControl REST unauthenticated Remote Code Execution Vulnerability, as well as newer vulnerabilities such as:",
      "line_start": 1440
    },
    "u039": {
      "start": 1660,
      "end": 1756,
      "text": "CVE-2023-0669: Fortra GoAnyhwere Managed File Transfer (MFT) Remote Code Execution Vulnerability",
      "line_start": 1660
    },
    "u040": {
      "start": 1757,
      "end": 1825,
      "text": "CVE-2023-27350: PaperCut MF/NG Improper Access Control Vulnerability",
      "line_start": 1757
    },
    "u041": {
      "start": 1826,
      "end": 1902,
      "text": "LockBit affiliates have been documented exploiting numerous CVEs, including:",
      "line_start": 1826
    },
    "u042": {
      "start": 1903,
      "end": 1969,
      "text": "CVE-2021-44228: Apache Log4j2 Remote Code Execution Vulnerability,",
      "line_start": 1903
    },
    "u043": {
      "start": 1970,
      "end": 2080,
      "text": "CVE-2021-22986: F5 BIG-IP and BIG-IQ Centralized Management iControl REST Remote Code Execution Vulnerability,",
      "line_start": 1970
    },
    "u044": {
      "start": 2081,
      "end": 2140,
      "text": "CVE-2020-1472: NetLogon Privilege Escalation Vulnerability,",
      "line_start": 2081
    },
    "u045": {
      "start": 2141,
      "end": 2230,
      "text": "CVE-2019-0708: Microsoft Remote Desktop Services Remote Code Execution Vulnerability, and",
