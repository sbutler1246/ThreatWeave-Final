    "u001": {
      "start": 1,
      "end": 90,
      "text": "public higher education and K-12 schools, and emergency services (e.g., law enforcement).",
      "line_start": 0
    },
    "u002": {
      "start": 91,
      "end": 151,
      "text": "Number of LockBit ransomware attacks in the U.S. since 2020:",
      "line_start": 91
    },
    "u003": {
      "start": 152,
      "end": 193,
      "text": "About 1,700 attacks according to the FBI.",
      "line_start": 152
    },
    "u004": {
      "start": 194,
      "end": 232,
      "text": "Total of U.S. ransoms paid to LockBit:",
      "line_start": 194
    },
    "u005": {
      "start": 233,
      "end": 325,
      "text": "Approximately $91M since LockBit activity was first observed in the U.S. on January 5, 2020.",
      "line_start": 233
    },
    "u006": {
      "start": 326,
      "end": 361,
      "text": "Earliest observed LockBit activity:",
      "line_start": 326
    },
    "u007": {
      "start": 362,
      "end": 448,
      "text": "Australia: The earliest documented occurrence of LockBit 3.0 was in early August 2022.",
      "line_start": 362
    },
    "u008": {
      "start": 449,
      "end": 533,
      "text": "Canada: The first recorded instance of LockBit activity in Canada was in March 2020.",
      "line_start": 449
    },
    "u009": {
      "start": 534,
      "end": 622,
      "text": "New Zealand: The first recorded incident involving LockBit ransomware was in March 2021.",
      "line_start": 534
    },
    "u010": {
      "start": 623,
      "end": 693,
      "text": "United States: LockBit activity was first observed on January 5, 2020.",
      "line_start": 623
    },
    "u011": {
      "start": 694,
      "end": 734,
      "text": "Most recently observed LockBit activity:",
      "line_start": 694
    },
    "u012": {
      "start": 735,
      "end": 761,
      "text": "Australia: April 21, 2023.",
      "line_start": 735
    },
    "u013": {
      "start": 762,
      "end": 789,
      "text": "New Zealand: February 2023.",
      "line_start": 762
    },
    "u014": {
      "start": 790,
      "end": 833,
      "text": "United States: As recently as May 25, 2023.",
      "line_start": 790
    },
    "u015": {
      "start": 834,
      "end": 883,
      "text": "Operational activity related to LockBit in France",
      "line_start": 834
    },
    "u016": {
      "start": 884,
      "end": 1071,
      "text": "Since the first case in July 2020 to present, ANSSI has handled 80 alerts linked to the LockBit ransomware, which accounts for 11% of all ransomware cases handled by ANSSI in that period.",
      "line_start": 884
    },
    "u017": {
      "start": 1072,
      "end": 1246,
      "text": "In about 13% of those cases, ANSSI was not able to confirm nor deny the breach of its constituents’ networks – as the alerts were related to the threat actor’s online claims.",
      "line_start": 884
    },
    "u018": {
      "start": 1247,
      "end": 1305,
      "text": "So far, 69 confirmed incidents have been handled by ANSSI.",
      "line_start": 884
    },
    "u019": {
      "start": 1306,
      "end": 1459,
      "text": "Table 2 shows the LockBit activity observed by ANSSI versus overall ransomware activity tracked by the Computer Emergency Response Team-France (CERT-FR).",
      "line_start": 884
    },
    "u020": {
      "start": 1460,
      "end": 1495,
      "text": "Table 2: ANSSI-Observed LockBit vs.",
      "line_start": 1460
    },
