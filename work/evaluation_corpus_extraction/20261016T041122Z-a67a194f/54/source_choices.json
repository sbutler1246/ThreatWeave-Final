  "units": {
    "u001": {
      "start": 1,
      "end": 95,
      "text": "free, open source FTP (including SSH FTP), WebDAV, Amazon S3, and secure copy protocol client.",
      "line_start": 0
    },
    "u002": {
      "start": 96,
      "end": 204,
      "text": "Akira threat actors use it to transfer data from a compromised network to actor-controlled accounts [T1048].",
      "line_start": 0
    },
    "u003": {
      "start": 205,
      "end": 226,
      "text": "Update Nov. 13, 2025:",
      "line_start": 205
    },
    "u004": {
      "start": 227,
      "end": 232,
      "text": "7-zip",
      "line_start": 227
    },
    "u005": {
      "start": 233,
      "end": 314,
      "text": "A free, open source software that enables users to compress various file formats.",
      "line_start": 233
    },
    "u006": {
      "start": 315,
      "end": 430,
      "text": "Akira threat actors use an archive feature within the 7-zip tool to compress data to evade detection [T1027.015].15",
      "line_start": 233
    },
    "u007": {
      "start": 431,
      "end": 440,
      "text": "FileZilla",
      "line_start": 431
    },
    "u008": {
      "start": 441,
      "end": 516,
      "text": "An open source client that enables users to transfer files between servers.",
      "line_start": 441
    },
    "u009": {
      "start": 517,
      "end": 588,
      "text": "Akira threat actors use it maliciously for data exfiltration [T1048].16",
      "line_start": 441
    },
    "u010": {
      "start": 589,
      "end": 596,
      "text": "LogMeIn",
      "line_start": 589
    },
    "u011": {
      "start": 597,
      "end": 714,
      "text": "A legitimate remote access tool that Akira threat actors maliciously use to move laterally and establish persistence.",
      "line_start": 597
    },
    "u012": {
      "start": 715,
      "end": 722,
      "text": "NetScan",
      "line_start": 715
    },
    "u013": {
      "start": 723,
      "end": 828,
      "text": "A software suite used for IP address querying, Domain Name System (DNS) investigation, and port scanning.",
      "line_start": 723
    },
    "u014": {
      "start": 829,
      "end": 903,
      "text": "Akira threat actors use the tool maliciously for reconnaissance [T1046].17",
      "line_start": 723
    },
    "u015": {
      "start": 904,
      "end": 909,
      "text": "Ngrok",
      "line_start": 904
    },
    "u016": {
      "start": 910,
      "end": 942,
      "text": "A legitimate reverse proxy tool.",
      "line_start": 910
    },
    "u017": {
      "start": 943,
      "end": 1064,
      "text": "Akira threat actors maliciously use this tool to create secure tunnels to servers they use for data exfiltration [T1572].",
      "line_start": 910
    },
    "u018": {
      "start": 1065,
      "end": 1072,
      "text": "NetExec",
      "line_start": 1065
    },
    "u019": {
      "start": 1073,
      "end": 1175,
      "text": "Linux-based network service exploitation tool that automates the assessment of large network security.",
      "line_start": 1073
    },
    "u020": {
      "start": 1176,
      "end": 1185,
      "text": "PowerTool",
      "line_start": 1176
    },
    "u021": {
      "start": 1186,
      "end": 1308,
      "text": "A tool used by Akira threat actors to exploit the Zemana AntiMalware driver and terminate antivirus processes [T1562.001].",
      "line_start": 1186
    },
    "u022": {
      "start": 1309,
      "end": 1321,
      "text": "PSEXESVC.exe",
      "line_start": 1309
    },
    "u023": {
      "start": 1322,
      "end": 1445,
      "text": "A Windows executable file potentially used by Akira threat actors for remote execution and payload deployments [T1569.002].",
      "line_start": 1322
    },
    "u024": {
      "start": 1446,
      "end": 1454,
      "text": "SystemBC",
      "line_start": 1446
    },
    "u025": {
      "start": 1455,
      "end": 1574,
      "text": "Multi-purpose malware that Akira threat actors use as both a remote access trojan (RAT) and a proxy bot [T1090][T1219].",
      "line_start": 1455
    },
    "u026": {
      "start": 1575,
      "end": 1603,
      "text": "Veeam Backup and Replication",
      "line_start": 1575
    },
    "u027": {
      "start": 1604,
      "end": 1754,
      "text": "A legitimate backup solution that Akira threat actors have exploited vulnerabilities in for initial access (and potentially for privilege escalation).",
      "line_start": 1604
    },
    "u028": {
      "start": 1755,
      "end": 1768,
      "text": "Cobalt Strike",
      "line_start": 1755
    },
    "u029": {
      "start": 1769,
      "end": 1905,
      "text": "A commercial penetration testing framework abused by Akira threat actors for lateral movement, C2, and privilege escalation [T1059.001].",
      "line_start": 1769
    },
    "u030": {
      "start": 1906,
      "end": 1916,
      "text": "PuTTY/PSCP",
      "line_start": 1906
    },
    "u031": {
      "start": 1917,
      "end": 2035,
      "text": "Variants of Secure Copy Protocol (SCP)/SFTP tools that can be used for data exfiltration or remote management [T1048].",
      "line_start": 1917
    },
    "u032": {
      "start": 2036,
      "end": 2048,
      "text": "Vssadmin.exe",
      "line_start": 2036
    },
    "u033": {
      "start": 2049,
      "end": 2127,
      "text": "A Windows executable used by Akira threat actors to delete VSS copies [T1490].",
      "line_start": 2049
    },
    "u034": {
      "start": 2128,
      "end": 2136,
      "text": "Level.io",
      "line_start": 2128
    },
    "u035": {
      "start": 2137,
      "end": 2214,
      "text": "A remote monitoring and management platform leveraged by Akira threat actors.",
      "line_start": 2137
    }
  },
