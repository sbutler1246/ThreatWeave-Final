      "text": "Valid Accounts",
      "line_start": 1376
    },
    "u028": {
      "start": 1391,
      "end": 1396,
      "text": "T1078",
      "line_start": 1391
    },
    "u029": {
      "start": 1397,
      "end": 1490,
      "text": "Akira threat actors obtain and abuse credentials of existing accounts to gain initial access.",
      "line_start": 1397
    },
    "u030": {
      "start": 1491,
      "end": 1515,
      "text": "External Remote Services",
      "line_start": 1491
    },
    "u031": {
      "start": 1516,
      "end": 1521,
      "text": "T1133",
      "line_start": 1516
    },
    "u032": {
      "start": 1522,
      "end": 1625,
      "text": "Akira threat actors use remote access services, such as RDP or VPN connections, to gain initial access.",
      "line_start": 1522
    },
    "u033": {
      "start": 1626,
      "end": 1659,
      "text": "Exploit Public Facing Application",
      "line_start": 1626
    },
    "u034": {
      "start": 1660,
      "end": 1665,
      "text": "T1190",
      "line_start": 1660
    },
    "u035": {
      "start": 1666,
      "end": 1763,
      "text": "Akira threat actors exploit vulnerabilities in internet-facing systems to gain access to systems.",
      "line_start": 1666
    },
    "u036": {
      "start": 1764,
      "end": 1798,
      "text": "Phishing: Spearphishing Attachment",
      "line_start": 1764
    },
