    },
    "u005": {
      "start": 40,
      "end": 162,
      "text": "LockBit affiliates use SoftPerfect Network Scanner, Advanced IP Scanner, or Advanced Port Scanner to scan target networks.",
      "line_start": 40
    },
    "u006": {
      "start": 163,
      "end": 300,
      "text": "LockBit affiliates may use SoftPerfect Network Scanner, Advanced Port Scanner, and AdFind to enumerate connected machines in the network.",
      "line_start": 163
    },
    "u007": {
      "start": 301,
      "end": 329,
      "text": "System Information Discovery",
      "line_start": 301
    },
    "u008": {
      "start": 330,
      "end": 335,
      "text": "T1082",
      "line_start": 330
    },
    "u009": {
      "start": 336,
      "end": 529,
      "text": "LockBit affiliates will enumerate system information to include hostname, host configuration, domain information, local drive configuration, remote shares, and mounted external storage devices.",
      "line_start": 336
    },
    "u010": {
      "start": 530,
      "end": 582,
      "text": "System Location Discovery: System Language Discovery",
      "line_start": 530
    },
    "u011": {
      "start": 583,
      "end": 592,
      "text": "T1614.001",
      "line_start": 583
    },
    "u012": {
      "start": 593,
      "end": 689,
      "text": "LockBit 3.0 will not infect machines with language settings that match a defined exclusion list.",
      "line_start": 593
    },
    "u013": {
      "start": 690,
      "end": 771,
