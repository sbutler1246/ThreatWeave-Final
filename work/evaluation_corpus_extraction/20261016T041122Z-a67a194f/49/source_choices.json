  "units": {
    "u001": {
      "start": 1,
      "end": 12,
      "text": "escalation.",
      "line_start": 0
    },
    "u002": {
      "start": 13,
      "end": 274,
      "text": "For network discovery and reconnaissance, actors use tools like SoftPerfect, Advanced IP Scanner, and NetScan [T1016]. net Windows commands [T1059.003] are used to identify domain controllers [T1018] and gather information on domain trust relationships [T1482].",
      "line_start": 0
    },
    "u003": {
      "start": 275,
      "end": 378,
      "text": "See Table 1 for a descriptive listing of tools leveraged for malicious purposes by Akira threat actors.",
      "line_start": 275
    },
    "u004": {
      "start": 379,
      "end": 400,
      "text": "Update Nov. 13, 2025:",
      "line_start": 379
    },
    "u005": {
      "start": 401,
      "end": 554,
      "text": "The authoring organizations observed Akira threat actors using nltest /dclist: and nltest /DOMAIN_TRUSTS [T1018][T1482] for network and domain discovery.",
      "line_start": 401
    },
    "u006": {
      "start": 555,
      "end": 565,
      "text": "End Update",
      "line_start": 555
    },
    "u007": {
      "start": 566,
      "end": 581,
      "text": "Defense Evasion",
      "line_start": 566
    },
    "u008": {
      "start": 582,
      "end": 694,
      "text": "As Akira threat actors prepare for lateral movement, they commonly disable security software to avoid detection.",
      "line_start": 582
    },
    "u009": {
      "start": 695,
      "end": 863,
      "text": "Cybersecurity researchers observed Akira threat actors using PowerTool to exploit the Zemana AntiMalware driver10 and terminate antivirus-related processes [T1562.001].",
      "line_start": 582
    },
    "u010": {
      "start": 864,
      "end": 885,
      "text": "Update Nov. 13, 2025:",
      "line_start": 864
    },
    "u011": {
      "start": 886,
      "end": 1085,
      "text": "In addition, the authoring organizations observed Akira threat actors abusing remote access tools such as AnyDesk and LogMeIn [T1219] to maintain persistence and blend in with administrator activity.",
      "line_start": 886
    },
    "u012": {
      "start": 1086,
      "end": 1230,
      "text": "Akira threat actors leverage Impacket (an open source tool designed for network protocol manipulation) to execute the remote command wmiexec.py.",
      "line_start": 886
    },
    "u013": {
      "start": 1231,
      "end": 1371,
      "text": "To evade detection, Akira threat actors implement techniques such as uninstalling endpoint detection and response (EDR) systems [T1562.001].",
      "line_start": 886
    },
    "u014": {
      "start": 1372,
      "end": 1382,
      "text": "End Update",
      "line_start": 1372
    },
    "u015": {
      "start": 1383,
      "end": 1403,
      "text": "Privilege Escalation",
      "line_start": 1383
    },
    "u016": {
      "start": 1404,
      "end": 1425,
      "text": "Update Nov. 13, 2025:",
      "line_start": 1404
    },
    "u017": {
      "start": 1426,
      "end": 1608,
      "text": "The authoring organizations observed Akira threat actors creating new user accounts and adding them to the administrator group to establish a foothold in the environment [T1136.001].",
      "line_start": 1426
    },
    "u018": {
      "start": 1609,
      "end": 1828,
      "text": "In a reported incident, Akira threat actors bypassed Virtual Machine Disk (VMDK) file protection by temporarily powering down the domain controller’s VM, copying the VMDK files, and attaching them to a newly created VM.",
      "line_start": 1426
    },
    "u019": {
      "start": 1829,
      "end": 2167,
      "text": "This sequence of actions enabled them to extract the NTDS.dit file and the SYSTEM hive, ultimately compromising a highly privileged domain administrator’s account [T1003.002][T1003.003].11 Akira threat actors have also been observed leveraging services like Veeam.Backup.MountService.exe for privilege escalation (CVE-2024-40711) [T1068].",
      "line_start": 1426
    },
    "u020": {
      "start": 2168,
      "end": 2178,
      "text": "End Update",
      "line_start": 2168
    },
    "u021": {
      "start": 2179,
      "end": 2195,
      "text": "Lateral Movement",
      "line_start": 2179
    },
    "u022": {
      "start": 2196,
      "end": 2217,
      "text": "Update Nov. 13, 2025:",
      "line_start": 2196
    }
  },
