  "units": {
    "u001": {
      "start": 0,
      "end": 162,
      "text": "1003.003].11 Akira threat actors have also been observed leveraging services like Veeam.Backup.MountService.exe for privilege escalation (CVE-2024-40711) [T1068].",
      "line_start": 0
    },
    "u002": {
      "start": 163,
      "end": 173,
      "text": "End Update",
      "line_start": 163
    },
    "u003": {
      "start": 174,
      "end": 190,
      "text": "Lateral Movement",
      "line_start": 174
    },
    "u004": {
      "start": 191,
      "end": 212,
      "text": "Update Nov. 13, 2025:",
      "line_start": 191
    },
    "u005": {
      "start": 213,
      "end": 320,
      "text": "To pivot laterally, Akira threat actors use legitimate remote access tools like AnyDesk or LogMeIn [T1219].",
      "line_start": 213
    },
    "u006": {
      "start": 321,
      "end": 353,
      "text": "They also employ RDP [T1021.001]",
      "line_start": 213
    },
    "u007": {
      "start": 355,
      "end": 370,
      "text": "SSH [T1021.004]",
      "line_start": 213
    },
    "u008": {
      "start": 372,
      "end": 450,
      "text": "and MobaXterm to expand their presence within the compromised network [T1021].",
      "line_start": 213
    },
    "u009": {
      "start": 451,
      "end": 461,
      "text": "End Update",
      "line_start": 451
    },
    "u010": {
      "start": 462,
      "end": 481,
      "text": "Command and Control",
      "line_start": 462
    },
    "u011": {
      "start": 482,
      "end": 503,
      "text": "Update Nov. 13, 2025:",
      "line_start": 482
    },
    "u012": {
      "start": 504,
      "end": 673,
      "text": "Based on observations from the authoring organizations and trusted third-party reporting, it has been determined that Megazord has likely fallen out of use since 2024.12",
      "line_start": 504
    },
    "u013": {
      "start": 674,
      "end": 684,
      "text": "End Update",
      "line_start": 674
    },
    "u014": {
      "start": 685,
      "end": 867,
      "text": "Trusted third-party investigations revealed that Akira threat actors deployed two distinct ransomware variants against different system architectures during one attempted compromise.",
      "line_start": 685
    },
    "u015": {
      "start": 868,
      "end": 1153,
      "text": "Analysts first identified Akira threat actors deploying the Windows-specific “Megazord” ransomware, and further investigation revealed the threat actors concurrently deployed a second payload during the attack, later identified as a novel variant of the Akira ESXi encryptor, Akira_v2.",
      "line_start": 685
    },
    "u016": {
      "start": 1154,
      "end": 1175,
      "text": "Update Nov. 13, 2025:",
      "line_start": 1154
    },
    "u017": {
      "start": 1176,
      "end": 1337,
      "text": "The authoring organizations observed Akira threat actors establishing command and control (C2) communications by using tunneling utilities, such as Ngrok [T1572]",
      "line_start": 1176
    },
    "u018": {
      "start": 1339,
      "end": 1403,
      "text": "to initiate encrypted sessions that bypass perimeter monitoring.",
      "line_start": 1176
    },
    "u019": {
      "start": 1404,
      "end": 1550,
      "text": "They also use PowerShell and Windows Management Instrumentation Command-line (WMIC) [T1059.001] to disable services and execute malicious scripts.",
      "line_start": 1176
    },
    "u020": {
      "start": 1551,
      "end": 1561,
      "text": "End Update",
      "line_start": 1551
    },
    "u021": {
      "start": 1562,
      "end": 1585,
      "text": "Exfiltration and Impact",
      "line_start": 1562
    },
    "u022": {
      "start": 1586,
      "end": 1727,
      "text": "Akira threat actors leverage tools such as FileZilla and WinRAR to collect data [T1560.001] and WinSCP and RClone to exfiltrate data [T1048].",
      "line_start": 1586
    },
    "u023": {
      "start": 1728,
      "end": 1858,
      "text": "To establish C2 channels, threat actors leverage readily available tools like AnyDesk, MobaXterm, RustDesk, and Cloudflare Tunnel.",
      "line_start": 1586
    },
    "u024": {
      "start": 1859,
      "end": 2037,
      "text": "These tools enable exfiltration through various protocols such as File Transfer Protocol (FTP), Secure File Transfer Protocol (SFTP), and cloud storage services like Mega [T1537]",
      "line_start": 1586
    },
    "u025": {
      "start": 2039,
      "end": 2074,
      "text": "to connect to exfiltration servers.",
      "line_start": 1586
    },
    "u026": {
      "start": 2075,
      "end": 2179,
      "text": "In some instances, Akira threat actors use Ngrok to create secure tunnels for data exfiltration [T1090].",
      "line_start": 1586
    }
  },
