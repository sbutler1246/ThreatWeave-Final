  "units": {
    "u001": {
      "start": 1,
      "end": 16,
      "text": "(Mutex) Created",
      "line_start": 0
    },
    "u002": {
      "start": 17,
      "end": 101,
      "text": "When executed, LockBit 3.0 will create the mutex, Global\\<MD4 hash of machine GUID>,",
      "line_start": 17
    },
    "u003": {
      "start": 102,
      "end": 216,
      "text": "and check to see if this mutex has already been created to avoid running more than one instance of the ransomware.",
      "line_start": 102
    },
    "u004": {
      "start": 217,
      "end": 254,
      "text": "UAC Bypass via Elevated COM Interface",
      "line_start": 217
    },
    "u005": {
      "start": 255,
      "end": 411,
      "text": "LockBit 3.0 is capable of bypassing User Account Control (UAC) to execute code with elevated privileges via elevated Component Object Model (COM) Interface.",
      "line_start": 255
    },
    "u006": {
      "start": 412,
      "end": 538,
      "text": "C:\\Windows\\System32\\dllhost.exe is spawned with high integrity with the command line GUID 3E5FC7F9-9A51-4367-9063-A120244FBEC.",
      "line_start": 255
    },
    "u007": {
      "start": 539,
      "end": 625,
      "text": "For example, %SYSTEM32%\\dllhost.exe/Processid:{3E5FC7F9-9A51-4367-9063- A120244FBEC7}.",
      "line_start": 539
    },
    "u008": {
      "start": 626,
      "end": 653,
      "text": "Volume Shadow Copy Deletion",
      "line_start": 626
    },
    "u009": {
      "start": 654,
      "end": 756,
      "text": "LockBit 3.0 uses Windows Management Instrumentation (WMI) to identify and delete Volume Shadow Copies.",
      "line_start": 654
    },
    "u010": {
      "start": 757,
      "end": 944,
      "text": "LockBit 3.0 uses select * from Win32_ShadowCopy to query for Volume Shadow copies, Win32_ShadowCopy.ID to obtain the ID of the shadow copy, and DeleteInstance to delete any shadow copies.",
      "line_start": 654
    },
    "u011": {
      "start": 945,
      "end": 963,
      "text": "Registry Artifacts",
      "line_start": 945
    },
