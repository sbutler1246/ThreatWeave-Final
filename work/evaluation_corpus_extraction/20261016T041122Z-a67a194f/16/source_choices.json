  "units": {
    "u001": {
      "start": 0,
      "end": 11,
      "text": "’s network.",
      "line_start": 0
    },
    "u002": {
      "start": 12,
      "end": 98,
      "text": "Ransomware operators often use open source projects to aid their intrusion activities.",
      "line_start": 0
    },
    "u003": {
      "start": 99,
      "end": 223,
      "text": "Historically, Royal actors were observed leveraging Chisel, Secure Shell (SSH) client, PuTTY, OpenSSH, and MobaXterm [T1572]",
      "line_start": 99
    },
    "u004": {
      "start": 225,
      "end": 269,
      "text": "to communicate with their C2 infrastructure.",
      "line_start": 99
    },
    "u005": {
      "start": 270,
      "end": 302,
      "text": "Lateral Movement and Persistence",
      "line_start": 270
    },
    "u006": {
      "start": 303,
      "end": 472,
      "text": "(Updated August 7, 2024) Historically, Royal threat actors used RDP and legitimate operating system (OS) diagnostic tools to move laterally across a network [T1021.001].",
      "line_start": 303
    },
    "u007": {
      "start": 473,
      "end": 565,
      "text": "BlackSuit actors used RDP and PsExec as well but also use SMB [T1021.001] to move laterally.",
      "line_start": 303
    },
    "u008": {
      "start": 566,
      "end": 698,
      "text": "In one confirmed case, BlackSuit actors used a legitimate admin account [T1078] to remotely log on to the domain controller via SMB.",
      "line_start": 303
    },
    "u009": {
      "start": 699,
      "end": 836,
      "text": "Once on the domain controller, the threat actor deactivated antivirus software [T1562.001] by modifying Group Policy Objects [T1484.001].",
      "line_start": 303
    },
    "u010": {
      "start": 837,
      "end": 1008,
      "text": "(Updated August 7, 2024) FBI observed BlackSuit actors using legitimate remote monitoring and management (RMM) software to maintain persistence in victim networks [T1133].",
      "line_start": 837
    },
    "u011": {
      "start": 1009,
      "end": 1133,
      "text": "(New August 7, 2024) BlackSuit actors use SystemBC and Gootloader malware to load additional tools and maintain persistence.",
      "line_start": 1009
    },
    "u012": {
      "start": 1134,
      "end": 1165,
      "text": "Discovery and Credential Access",
      "line_start": 1134
    },
    "u013": {
      "start": 1166,
      "end": 1294,
      "text": "(New August 7, 2024) BlackSuit actors have been observed using SharpShares and SoftPerfect NetWorx to enumerate victim networks.",
      "line_start": 1166
    },
    "u014": {
      "start": 1295,
      "end": 1434,
      "text": "The publicly available credential stealing tool Mimikatz and password harvesting tools from Nirsoft have also been found on victim systems.",
      "line_start": 1166
    },
    "u015": {
      "start": 1435,
      "end": 1508,
      "text": "Tools such as PowerTool and GMER are often used to kill system processes.",
      "line_start": 1166
    },
    "u016": {
      "start": 1509,
      "end": 1521,
      "text": "Exfiltration",
      "line_start": 1509
    },
    "u017": {
      "start": 1522,
      "end": 1748,
      "text": "BlackSuit actors exfiltrate data from victim networks by repurposing legitimate cyber penetration testing tools, such as Cobalt Strike, and malware tools/derivatives, such as Ursnif/Gozi, for data aggregation and exfiltration.",
      "line_start": 1522
    },
    "u018": {
      "start": 1749,
      "end": 1867,
      "text": "According to third-party reporting, BlackSuit actors’ first hop in exfiltration and other operations is usually a U.S.",
      "line_start": 1522
    },
    "u019": {
      "start": 1868,
      "end": 1879,
      "text": "IP address.",
      "line_start": 1522
    },
    "u020": {
      "start": 1880,
      "end": 1967,
      "text": "(New August 7, 2024) BlackSuit actors also use RClone and Brute Ratel for exfiltration.",
      "line_start": 1880
    },
    "u021": {
      "start": 1968,
      "end": 1978,
      "text": "Encryption",
      "line_start": 1968
    },
    "u022": {
      "start": 1979,
      "end": 2036,
      "text": "Before starting the encryption process, BlackSuit actors:",
      "line_start": 1979
    },
    "u023": {
      "start": 2037,
      "end": 2166,
      "text": "Use Windows Restart Manager to determine whether targeted files are currently in use or blocked by other applications [T1486].[1]",
      "line_start": 2037
    },
    "u024": {
      "start": 2167,
      "end": 2275,
      "text": "Use Windows Volume Shadow Copy service (vssadmin.exe) to delete shadow copies to inhibit system recovery.[1]",
      "line_start": 2167
    }
  },
