    "u042": {
      "start": 1445,
      "end": 1538,
      "text": "(New August 7, 2024) Please reference YARA rule below to aid in detecting BlackSuit activity.",
      "line_start": 1445
    },
    "u043": {
      "start": 1539,
      "end": 1655,
      "text": "Note: The YARA rule is derived from FBI investigations and is not guaranteed to detect confirmed malicious activity.",
      "line_start": 1445
    },
    "u044": {
      "start": 1656,
      "end": 1684,
      "text": "private rule is_executable {",
