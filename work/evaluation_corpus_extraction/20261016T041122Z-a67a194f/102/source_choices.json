  "units": {
    "u001": {
      "start": 1,
      "end": 29,
      "text": "control (C2) server [T1027].",
      "line_start": 0
    },
    "u002": {
      "start": 30,
      "end": 210,
      "text": "Once completed, LockBit 3.0 may delete itself from the disk [T1070.004] as well as any Group Policy updates that were made, depending on which options were set at compilation time.",
      "line_start": 30
    },
    "u003": {
      "start": 211,
      "end": 223,
      "text": "EXFILTRATION",
      "line_start": 211
    },
    "u004": {
      "start": 224,
      "end": 329,
      "text": "LockBit 3.0 affiliates use Stealbit, a custom exfiltration tool used previously with LockBit 2.0 [TA0010]",
      "line_start": 224
    },
    "u005": {
      "start": 331,
      "end": 400,
      "text": "rclone, an open-source command line cloud storage manager [T1567.002]",
      "line_start": 224
    },
    "u006": {
      "start": 402,
      "end": 472,
      "text": "and publicly available file sharing services, such as MEGA [T1567.002]",
      "line_start": 224
    },
    "u007": {
      "start": 474,
      "end": 537,
      "text": "to exfiltrate sensitive company data files prior to encryption.",
      "line_start": 224
    },
    "u008": {
      "start": 538,
      "end": 755,
      "text": "While rclone and many publicly available file sharing services are primarily used for legitimate purposes, they can also be used by threat actors to aid in system compromise, network exploration, or data exfiltration.",
      "line_start": 224
    },
    "u009": {
      "start": 756,
      "end": 885,
      "text": "LockBit 3.0 affiliates often use other publicly available file sharing services to exfiltrate data as well [T1567] (see Table 1).",
      "line_start": 224
    },
    "u010": {
      "start": 886,
      "end": 972,
      "text": "Table 1: Anonymous File Sharing Sites Used to Exfiltrate Data Before System Encryption",
      "line_start": 886
    },
    "u011": {
      "start": 973,
      "end": 990,
      "text": "File Sharing Site",
      "line_start": 973
    },
    "u012": {
      "start": 991,
      "end": 1019,
      "text": "https://www.premiumize[.]com",
      "line_start": 991
    },
    "u013": {
      "start": 1020,
      "end": 1043,
      "text": "https://anonfiles[.]com",
      "line_start": 1020
    },
    "u014": {
      "start": 1044,
      "end": 1071,
      "text": "https://www.sendspace[.]com",
      "line_start": 1044
    },
    "u015": {
      "start": 1072,
      "end": 1089,
      "text": "https://fex[.]net",
      "line_start": 1072
    },
    "u016": {
      "start": 1090,
      "end": 1111,
      "text": "https://transfer[.]sh",
      "line_start": 1090
    },
    "u017": {
      "start": 1112,
      "end": 1137,
      "text": "https://send.exploit[.]in",
      "line_start": 1112
    },
    "u018": {
      "start": 1138,
      "end": 1179,
      "text": "LEVERAGING FREEWARE AND OPEN-SOURCE TOOLS",
      "line_start": 1138
    },
    "u019": {
      "start": 1180,
      "end": 1287,
      "text": "LockBit affiliates have been observed using various freeware and open-source tools during their intrusions.",
      "line_start": 1180
    },
    "u020": {
      "start": 1288,
      "end": 1438,
      "text": "These tools are used for a range of activities such as network reconnaissance, remote access and tunneling, credential dumping, and file exfiltration.",
      "line_start": 1180
    },
    "u021": {
      "start": 1439,
      "end": 1615,
      "text": "Use of PowerShell and Batch scripts are observed across most intrusions, which focus on system discovery, reconnaissance, password/credential hunting, and privilege escalation.",
      "line_start": 1180
    },
    "u022": {
      "start": 1616,
      "end": 1729,
      "text": "Artifacts of professional penetration-testing tools such as Metasploit and Cobalt Strike have also been observed.",
      "line_start": 1180
    },
    "u023": {
      "start": 1730,
      "end": 1859,
      "text": "See Table 2 for a list of legitimate freeware and open-source tools LockBit affiliates have repurposed for ransomware operations:",
      "line_start": 1180
    },
    "u024": {
      "start": 1860,
      "end": 1930,
      "text": "Table 2: Freeware and Open-Source Tools Used by LockBit 3.0 Affiliates",
      "line_start": 1860
    },
    "u025": {
      "start": 1931,
      "end": 1935,
      "text": "Tool",
      "line_start": 1931
    },
    "u026": {
      "start": 1936,
      "end": 1947,
      "text": "Description",
      "line_start": 1936
    },
    "u027": {
      "start": 1948,
      "end": 1963,
      "text": "MITRE ATT&CK ID",
      "line_start": 1948
    },
    "u028": {
      "start": 1964,
      "end": 1974,
      "text": "Chocolatey",
      "line_start": 1964
    },
    "u029": {
      "start": 1975,
      "end": 2016,
      "text": "Command-line package manager for Windows.",
      "line_start": 1975
    },
    "u030": {
      "start": 2017,
      "end": 2022,
      "text": "T1072",
      "line_start": 2017
    },
    "u031": {
      "start": 2023,
