      "text": "T1048",
      "line_start": 1286
    },
    "u046": {
      "start": 1292,
      "end": 1365,
      "text": "Akira threat actors use file transfer tools like WinSCP to transfer data.",
      "line_start": 1292
    },
    "u047": {
      "start": 1366,
      "end": 1396,
      "text": "Transfer Data to Cloud Account",
      "line_start": 1366
    },
    "u048": {
      "start": 1397,
      "end": 1402,
      "text": "T1537",
      "line_start": 1397
    },
    "u049": {
      "start": 1403,
      "end": 1536,
      "text": "Akira threat actors use tools like CloudZilla to exfiltrate data to a cloud account and connect to exfiltration servers they control.",
      "line_start": 1403
    },
    "u050": {
      "start": 1537,
      "end": 1597,
      "text": "Exfiltration Over Web Service: Exfiltration to Cloud Storage",
      "line_start": 1537
    },
    "u051": {
      "start": 1598,
      "end": 1607,
      "text": "T1567.002",
      "line_start": 1598
    },
    "u052": {
      "start": 1608,
      "end": 1705,
      "text": "Akira threat actors leverage RClone to sync files with cloud storage services to exfiltrate data.",
      "line_start": 1608
    },
