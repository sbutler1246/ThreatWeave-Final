    "u031": {
      "start": 702,
      "end": 866,
      "text": "Once new group policies are added, a PowerShell command using Group Policy update (GPUpdate) applies the new group policy changes to all computers on the AD domain.",
      "line_start": 702
    },
    "u032": {
      "start": 867,
      "end": 900,
      "text": "Force GPUpdate Powershell Command",
      "line_start": 867
    },
    "u033": {
      "start": 901,
      "end": 1039,
      "text": "powershell Get-ADComputer -filter * -Searchbase '%s' | Foreach-Object { Invoke- GPUpdate -computer $_.name -force -RandomDelayInMinutes 0}",
