      "text": "T1110",
      "line_start": 1225
    },
    "u027": {
      "start": 1231,
      "end": 1319,
      "text": "LockBit affiliates may leverage VPN or RDP brute force credentials as an initial access.",
      "line_start": 1231
    },
    "u028": {
      "start": 1320,
      "end": 1383,
      "text": "Credentials from Password Stores: Credentials from Web Browsers",
      "line_start": 1320
    },
    "u029": {
      "start": 1384,
      "end": 1393,
      "text": "T1555.003",
      "line_start": 1384
    },
    "u030": {
      "start": 1394,
      "end": 1471,
      "text": "LockBit 3.0 actors use PasswordFox to recover passwords from Firefox Browser.",
      "line_start": 1394
    },
    "u031": {
      "start": 1472,
      "end": 1493,
      "text": "OS Credential Dumping",
      "line_start": 1472
    },
    "u032": {
      "start": 1494,
      "end": 1499,
      "text": "T1003",
      "line_start": 1494
    },
    "u033": {
      "start": 1500,
      "end": 1595,
      "text": "LockBit 3.0 actors use ExtPassword or LostMyPassword to recover passwords from Windows systems.",
      "line_start": 1500
    },
    "u034": {
      "start": 1596,
      "end": 1631,
      "text": "OS Credential Dumping: LSASS Memory",
      "line_start": 1596
    },
    "u035": {
      "start": 1632,
      "end": 1641,
      "text": "T1003.001",
      "line_start": 1632
    },
    "u036": {
      "start": 1642,
      "end": 1734,
      "text": "LockBit affiliates may use Microsoft Sysinternals ProDump to dump the contents of lsass.exe.",
      "line_start": 1642
    },
    "u037": {
      "start": 1735,
      "end": 1793,
      "text": "LockBit affiliates have used Mimikatz to dump credentials.",
      "line_start": 1735
    },
    "u038": {
      "start": 1794,
      "end": 1868,
      "text": "Table 11: LockBit Affiliates’ ATT&CK Techniques for Enterprise – Discovery",
