    "u002": {
      "start": 30,
      "end": 70,
      "text": "Impair Defenses: Disable or Modify Tools",
      "line_start": 30
    },
    "u003": {
      "start": 71,
      "end": 80,
      "text": "T1562.001",
      "line_start": 71
    },
    "u004": {
      "start": 81,
      "end": 230,
      "text": "LockBit 3.0 affiliates use Backstab, Defender Control, GMER, PCHunter, PowerTool, Process Hacker or TDSSKiller to disable EDR processes and services.",
      "line_start": 81
    },
    "u005": {
      "start": 231,
      "end": 310,
      "text": "LockBit 3.0 affiliates use Bat Armor to bypass the PowerShell execution Policy.",
      "line_start": 231
    },
    "u006": {
      "start": 311,
      "end": 410,
      "text": "LockBit affiliates may deploy a batch script, 123.bat, to disable and uninstall antivirus software.",
      "line_start": 311
    },
    "u007": {
      "start": 411,
      "end": 554,
      "text": "Lockbit 3.0 may modify and/or disable security tools including EDR and antivirus to avoid possible detection of malware, tools, and activities.",
      "line_start": 411
    },
    "u008": {
      "start": 555,
      "end": 598,
      "text": "Indicator Removal: Clear Windows Event Logs",
      "line_start": 555
    },
    "u009": {
      "start": 599,
      "end": 608,
      "text": "T1070.001",
      "line_start": 599
    },
    "u010": {
      "start": 609,
      "end": 664,
      "text": "LockBit executable clears the Windows Event Logs files.",
      "line_start": 609
    },
    "u011": {
      "start": 665,
      "end": 697,
      "text": "Indicator Removal: File Deletion",
      "line_start": 665
    },
    "u012": {
      "start": 698,
      "end": 707,
      "text": "T1070.004",
      "line_start": 698
    },
    "u013": {
      "start": 708,
      "end": 753,
      "text": "LockBit 3.0 will delete itself from the disk.",
      "line_start": 708
    },
    "u014": {
      "start": 754,
      "end": 785,
      "text": "Obfuscated Files or Information",
      "line_start": 754
    },
    "u015": {
      "start": 786,
      "end": 791,
      "text": "T1027",
      "line_start": 786
    },
    "u016": {
      "start": 792,
      "end": 889,
      "text": "LockBit 3.0 will send encrypted host and bot information to its command and control (C2) servers.",
      "line_start": 792
    },
    "u017": {
      "start": 890,
      "end": 939,
      "text": "Obfuscated Files or Information: Software Packing",
      "line_start": 890
    },
    "u018": {
      "start": 940,
      "end": 949,
      "text": "T1027.002",
      "line_start": 940
    },
    "u019": {
      "start": 950,
      "end": 1059,
      "text": "LockBit affiliates may perform software packing or virtual machine software protection to conceal their code.",
      "line_start": 950
    },
    "u020": {
      "start": 1060,
      "end": 1106,
      "text": "Blister Loader has been used for such purpose.",
      "line_start": 950
    },
    "u021": {
      "start": 1107,
      "end": 1189,
      "text": "Table 10: LockBit Affiliates’ ATT&CK Techniques for Enterprise – Credential Access",
      "line_start": 1107
    },
    "u022": {
