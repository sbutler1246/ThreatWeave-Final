    "u023": {
      "start": 827,
      "end": 859,
      "text": "Ransom Note (New August 7, 2024)",
      "line_start": 827
    },
    "u024": {
      "start": 860,
      "end": 932,
      "text": "Figure 1 shows the observed BlackSuit ransom notes delivered to victims.",
      "line_start": 860
    },
    "u025": {
      "start": 933,
      "end": 942,
      "text": "Figure 1.",
      "line_start": 933
    },
    "u026": {
      "start": 943,
      "end": 964,
      "text": "BlackSuit Ransom Note",
      "line_start": 933
    },
    "u027": {
      "start": 965,
      "end": 1058,
      "text": "Your safety service did a really poor job of protecting your files against our professionals.",
      "line_start": 965
    },
    "u028": {
      "start": 1059,
      "end": 1112,
      "text": "Extortioner named BlackSuit has attacked your system.",
      "line_start": 1059
    },
    "u029": {
      "start": 1113,
      "end": 1258,
      "text": "As a result all your essential files were encrypted and saved at a secure server for further use and publishing on the Web into the public realm.",
      "line_start": 1113
    },
    "u030": {
      "start": 1259,
      "end": 1412,
      "text": "Now we have all your files like: financial reports, intellectual property, accounting, law actions and complaints, personal files and so on and so forth.",
      "line_start": 1259
    },
    "u031": {
      "start": 1413,
      "end": 1460,
      "text": "We are able to solve this problem in one touch.",
      "line_start": 1413
    },
    "u032": {
      "start": 1461,
      "end": 1576,
      "text": "We (BlackSuit) are ready to give you an opportunity to get all the things back if you agree to make a deal with us.",
      "line_start": 1461
    }
