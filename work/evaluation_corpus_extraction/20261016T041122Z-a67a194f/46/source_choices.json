      "text": "ID",
      "line_start": 340
    },
    "u009": {
      "start": 343,
      "end": 346,
      "text": "Use",
      "line_start": 343
    },
    "u010": {
      "start": 347,
      "end": 361,
      "text": "User Execution",
      "line_start": 347
    },
    "u011": {
      "start": 362,
      "end": 367,
      "text": "T1204",
      "line_start": 362
    },
    "u012": {
      "start": 368,
      "end": 536,
      "text": "Black Basta affiliates have used social engineering techniques to convince users to execute legitimate remote access tools such as AnyDesk and Microsoft’s Quick Assist.",
      "line_start": 368
    },
    "u013": {
      "start": 537,
      "end": 582,
      "text": "Command and Scripting Interpreter: PowerShell",
      "line_start": 537
    },
    "u014": {
      "start": 583,
      "end": 592,
      "text": "T1059.001",
      "line_start": 583
    },
    "u015": {
      "start": 593,
      "end": 667,
      "text": "Black Basta affiliates have used PowerShell to disable antivirus products.",
      "line_start": 593
    },
    "u016": {
