  "units": {
    "u001": {
      "start": 0,
      "end": 182,
      "text": "1-42278 [CWE-20] and CVE-2021-42287 [CWE-269]), and PrintNightmare (CVE-2021-34527 [CWE-269]) vulnerabilities for local and Windows Active Domain privilege escalation [T1068].[1],[2]",
      "line_start": 0
    },
    "u002": {
      "start": 183,
      "end": 199,
      "text": "Lateral Movement",
      "line_start": 183
    },
    "u003": {
      "start": 200,
      "end": 326,
      "text": "Black Basta affiliates use tools such as BITSAdmin and PsExec, along with Remote Desktop Protocol (RDP), for lateral movement.",
      "line_start": 200
    },
    "u004": {
      "start": 327,
      "end": 466,
      "text": "Some affiliates also use tools like Splashtop, Screen Connect, and Cobalt Strike beacons to assist with remote access and lateral movement.",
      "line_start": 200
    },
    "u005": {
      "start": 467,
      "end": 494,
      "text": "Exfiltration and Encryption",
      "line_start": 467
    },
    "u006": {
      "start": 495,
      "end": 581,
      "text": "Black Basta affiliates use RClone to facilitate data exfiltration prior to encryption.",
      "line_start": 495
    },
    "u007": {
      "start": 582,
      "end": 985,
      "text": "Prior to exfiltration, cybersecurity researchers have observed Black Basta affiliates using PowerShell [T1059.001] to disable antivirus products, and in some instances, deploying a tool called Backstab, designed to disable endpoint detection and response (EDR) tooling [T1562.001].[3] Once antivirus programs are terminated, a ChaCha20 algorithm with an RSA-4096 public key fully encrypts files [T1486].",
      "line_start": 495
    },
    "u008": {
      "start": 986,
      "end": 1245,
      "text": "A .basta or otherwise random file extension is added to file names and a ransom note titled readme.txt is left on the compromised system.[4] To further inhibit system recovery, affiliates use the vssadmin.exe program to delete volume shadow copies [T1490].[5]",
      "line_start": 495
    },
    "u009": {
      "start": 1246,
      "end": 1261,
      "text": "Leveraged Tools",
      "line_start": 1246
    },
    "u010": {
      "start": 1262,
      "end": 1351,
      "text": "See Table 1 for publicly available tools and applications used by Black Basta affiliates.",
      "line_start": 1262
    },
    "u011": {
      "start": 1352,
      "end": 1415,
      "text": "This includes legitimate tools repurposed for their operations.",
      "line_start": 1262
    },
    "u012": {
      "start": 1416,
      "end": 1461,
      "text": "Table 1: Tools Used by Black Basta Affiliates",
      "line_start": 1416
    },
    "u013": {
      "start": 1462,
      "end": 1471,
      "text": "Tool Name",
      "line_start": 1462
    },
    "u014": {
      "start": 1472,
      "end": 1483,
      "text": "Description",
      "line_start": 1472
    },
    "u015": {
      "start": 1484,
      "end": 1491,
      "text": "AnyDesk",
      "line_start": 1484
    },
    "u016": {
      "start": 1492,
      "end": 1606,
      "text": "A remote monitoring and management tool used by Black Basta affiliates to gain access to a victim user’s endpoint.",
      "line_start": 1492
    },
    "u017": {
      "start": 1607,
      "end": 1622,
      "text": "Microsoft Teams",
      "line_start": 1607
    },
    "u018": {
      "start": 1623,
      "end": 1741,
      "text": "A messaging application used within organizations and maliciously used by Black Basta affiliates to contact employees.",
      "line_start": 1623
    },
    "u019": {
      "start": 1742,
      "end": 1764,
      "text": "Microsoft Quick Assist",
      "line_start": 1742
    },
    "u020": {
      "start": 1765,
      "end": 1879,
      "text": "A remote monitoring and management tool used by Black Basta affiliates to gain access to a victim user’s endpoint.",
      "line_start": 1765
    },
    "u021": {
      "start": 1880,
      "end": 1889,
      "text": "BITSAdmin",
      "line_start": 1880
    },
    "u022": {
      "start": 1890,
      "end": 2071,
      "text": "A command-line utility that manages downloads/uploads between a client and server by using the Background Intelligent Transfer Service (BITS) to perform asynchronous file transfers.",
      "line_start": 1890
    },
    "u023": {
      "start": 2072,
      "end": 2085,
      "text": "Cobalt Strike",
      "line_start": 2072
    },
    "u024": {
      "start": 2086,
      "end": 2187,
      "text": "A penetration testing tool used by security professions to test the security of networks and systems.",
      "line_start": 2086
    },
    "u025": {
      "start": 2188,
      "end": 2275,
      "text": "Black Basta affiliates have used it to assist with lateral movement and file execution.",
      "line_start": 2086
    },
    "u026": {
      "start": 2276,
      "end": 2284,
      "text": "Mimikatz",
      "line_start": 2276
    }
  },
