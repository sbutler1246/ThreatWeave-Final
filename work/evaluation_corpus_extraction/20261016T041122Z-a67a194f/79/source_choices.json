      "text": "ID",
      "line_start": 120
    },
    "u005": {
      "start": 123,
      "end": 126,
      "text": "Use",
      "line_start": 123
    },
    "u006": {
      "start": 127,
      "end": 167,
      "text": "Indicator Removal: Clear Command History",
      "line_start": 127
    },
    "u007": {
      "start": 168,
      "end": 177,
      "text": "T1070.003",
      "line_start": 168
    },
    "u008": {
      "start": 178,
      "end": 270,
      "text": "Medusa actors attempt to cover their tracks by deleting the PowerShell command line history.",
      "line_start": 178
    },
    "u009": {
      "start": 271,
      "end": 326,
      "text": "Obfuscated Files or Information: Encrypted/Encoded File",
      "line_start": 271
    },
    "u010": {
      "start": 327,
      "end": 336,
      "text": "T1027.013",
      "line_start": 327
    },
    "u011": {
      "start": 337,
      "end": 427,
      "text": "Medusa actors use a well-known stealth technique that executes a base64 encrypted command.",
      "line_start": 337
    },
    "u012": {
      "start": 428,
      "end": 459,
      "text": "Obfuscated Files or Information",
      "line_start": 428
    },
    "u013": {
      "start": 460,
      "end": 465,
      "text": "T1027",
      "line_start": 460
    },
    "u014": {
      "start": 466,
      "end": 559,
      "text": "Medusa actors obfuscate a string by slicing it into pieces and referencing it via a variable.",
      "line_start": 466
    },
    "u015": {
      "start": 560,
      "end": 577,
      "text": "Indicator Removal",
      "line_start": 560
    },
    "u016": {
      "start": 578,
      "end": 583,
      "text": "T1070",
      "line_start": 578
    },
    "u017": {
      "start": 584,
      "end": 645,
      "text": "Medusa actors delete their previous work and tools installed.",
      "line_start": 584
    },
    "u018": {
      "start": 646,
      "end": 669,
      "text": "Disable or Modify Tools",
      "line_start": 646
    },
    "u019": {
      "start": 670,
      "end": 675,
      "text": "T1685",
      "line_start": 670
    },
    "u020": {
      "start": 676,
      "end": 715,
      "text": "Medusa actors kill or delete EDR tools.",
      "line_start": 676
    },
    "u021": {
      "start": 716,
      "end": 736,
      "text": "Direct Volume Access",
      "line_start": 716
    },
    "u022": {
      "start": 737,
      "end": 742,
      "text": "T1006",
      "line_start": 737
    },
    "u023": {
      "start": 743,
      "end": 877,
      "text": "Medusa actors use vssadmin to bypass Windows file access controls and file system monitoring tools to obtain copies of registry hives.",
      "line_start": 743
    },
    "u024": {
      "start": 878,
      "end": 914,
      "text": "Hide Artifacts: File/Path Exclusions",
      "line_start": 878
    },
    "u025": {
      "start": 915,
      "end": 924,
      "text": "T1564.012",
      "line_start": 915
    },
    "u026": {
      "start": 925,
      "end": 1028,
      "text": "(Updated Aug. 18, 2026) Medusa actors operate in pre-existing excluded folders within Windows Defender.",
      "line_start": 925
    },
    "u027": {
      "start": 1029,
      "end": 1047,
      "text": "Table 5: Discovery",
      "line_start": 1029
    },
