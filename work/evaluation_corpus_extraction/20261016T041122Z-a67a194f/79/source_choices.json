    },
    "u032": {
      "start": 1097,
      "end": 1102,
      "text": "T1046",
      "line_start": 1097
    },
    "u033": {
      "start": 1103,
      "end": 1169,
      "text": "Medusa actors used LOTL techniques to perform network enumeration.",
      "line_start": 1103
    },
    "u034": {
      "start": 1170,
      "end": 1198,
      "text": "File and Directory Discovery",
      "line_start": 1170
    },
    "u035": {
      "start": 1199,
      "end": 1204,
      "text": "T1083",
      "line_start": 1199
    },
    "u036": {
      "start": 1205,
      "end": 1273,
      "text": "Medusa actors use Windows Command Prompt for filesystem enumeration.",
      "line_start": 1205
    },
    "u037": {
      "start": 1274,
      "end": 1297,
      "text": "Network Share Discovery",
      "line_start": 1274
    },
    "u038": {
      "start": 1298,
      "end": 1303,
      "text": "T1135",
      "line_start": 1298
    },
    "u039": {
      "start": 1304,
      "end": 1391,
      "text": "Medusa actors query shared drives on the local system to gather sources of information.",
      "line_start": 1304
    },
    "u040": {
      "start": 1392,
      "end": 1430,
      "text": "System Network Configuration Discovery",
      "line_start": 1392
    },
    "u041": {
      "start": 1431,
      "end": 1436,
      "text": "T1016",
      "line_start": 1431
    },
    "u042": {
      "start": 1437,
      "end": 1513,
      "text": "Medusa actors use OS administrative utilities to gather network information.",
      "line_start": 1437
    },
    "u043": {
      "start": 1514,
      "end": 1542,
      "text": "System Information Discovery",
      "line_start": 1514
    },
    "u044": {
      "start": 1543,
      "end": 1548,
      "text": "T1082",
      "line_start": 1543
    },
    "u045": {
      "start": 1549,
      "end": 1628,
      "text": "Medusa actors use the command systeminfo to gather detailed system information.",
      "line_start": 1549
    },
    "u046": {
      "start": 1629,
      "end": 1656,
      "text": "System Owner/User Discovery",
      "line_start": 1629
    },
    "u047": {
      "start": 1657,
      "end": 1662,
      "text": "T1033",
      "line_start": 1657
    },
    "u048": {
      "start": 1663,
      "end": 1761,
      "text": "Medusa actors use the command query user to gather information about the currently logged in user.",
      "line_start": 1663
    },
    "u049": {
      "start": 1762,
      "end": 1798,
      "text": "System Network Connections Discovery",
      "line_start": 1762
    },
    "u050": {
      "start": 1799,
      "end": 1804,
      "text": "T1049",
      "line_start": 1799
    },
    "u051": {
      "start": 1805,
      "end": 1889,
      "text": "Medusa actors use the command netstat -a to gather a listing of network connections.",
      "line_start": 1805
    },
    "u052": {
      "start": 1890,
      "end": 1932,
      "text": "Permission Groups Discovery: Domain Groups",
      "line_start": 1890
    },
    "u053": {
      "start": 1933,
      "end": 1942,
      "text": "T1069.002",
      "line_start": 1933
    },
    "u054": {
      "start": 1943,
      "end": 2016,
      "text": "Medusa actors attempt to find domain-level group and permission settings.",
      "line_start": 1943
    },
    "u055": {
      "start": 2017,
      "end": 2043,
      "text": "Table 6: Credential Access",
      "line_start": 2017
    },
