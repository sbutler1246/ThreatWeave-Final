  "units": {
    "u001": {
      "start": 1,
      "end": 86,
      "text": "IABs use phishing campaigns as a primary method for delivering ransomware to victims.",
      "line_start": 0
    },
    "u002": {
      "start": 87,
      "end": 103,
      "text": "Table 4: Stealth",
      "line_start": 87
    },
    "u003": {
      "start": 104,
      "end": 119,
      "text": "Technique Title",
      "line_start": 104
    },
    "u004": {
