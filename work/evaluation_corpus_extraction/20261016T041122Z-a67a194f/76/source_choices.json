  "units": {
    "u001": {
      "start": 1,
      "end": 6,
      "text": "time.",
      "line_start": 0
    },
    "u002": {
      "start": 7,
      "end": 119,
      "text": "Additionally, Medusa actors research victim financial details and base their demands on publicly posted revenue.",
      "line_start": 0
    },
    "u003": {
      "start": 120,
      "end": 221,
      "text": "After a victim pays the ransom, Medusa actors claim to remove the victim’s information from the site.",
      "line_start": 0
    },
    "u004": {
      "start": 222,
      "end": 306,
      "text": "Note: There is no way to verify that Medusa actors remove victim data from the site.",
      "line_start": 0
    },
    "u005": {
      "start": 307,
      "end": 409,
      "text": "Medusa concurrently advertises sale of the data to interested parties before the countdown timer ends.",
      "line_start": 307
    },
    "u006": {
      "start": 410,
      "end": 492,
      "text": "Victims can pay $10,000 USD in cryptocurrency to add a day to the countdown timer.",
      "line_start": 307
    },
    "u007": {
      "start": 493,
      "end": 617,
      "text": "(Updated Aug. 18, 2026) Medusa actors generally request payment in Bitcoin but may demand payment in other cryptocurrencies.",
      "line_start": 493
    },
    "u008": {
      "start": 618,
      "end": 1002,
      "text": "FBI investigations identified that after paying the ransom, one victim was contacted by a separate Medusa actor who claimed the negotiator had stolen the ransom amount already paid and requested half of the payment be made again to provide the “true decryptor”—potentially indicating a triple-extortion scheme, or operational dysfunction and a lack of cohesion among ransomware group.",
      "line_start": 618
    },
    "u009": {
      "start": 1003,
      "end": 1027,
      "text": "Indicators of Compromise",
      "line_start": 1003
    },
    "u010": {
      "start": 1028,
      "end": 1158,
      "text": "Table 1 and Table 2 are lists of the malicious IP addresses, the URLs, and the hashes of files obtained during FBI investigations.",
      "line_start": 1028
    },
    "u011": {
      "start": 1159,
      "end": 1214,
      "text": "Disclaimer: Some of these indicators may be legitimate.",
      "line_start": 1159
    },
    "u012": {
      "start": 1215,
      "end": 1331,
      "text": "The authoring agencies recommend organizations investigate or vet the IOCs prior to taking action, such as blocking.",
      "line_start": 1159
    },
