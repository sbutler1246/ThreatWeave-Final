      "text": "Execution",
      "line_start": 2071
    },
    "u037": {
      "start": 2081,
      "end": 2087,
      "text": "TA0002",
      "line_start": 2081
    },
    "u038": {
      "start": 2088,
      "end": 2139,
      "text": "LockBit 3.0 launches commands during its execution.",
      "line_start": 2088
    },
    "u039": {
      "start": 2140,
      "end": 2196,
      "text": "Command and Scripting Interpreter: Windows Command Shell",
      "line_start": 2140
    },
    "u040": {
