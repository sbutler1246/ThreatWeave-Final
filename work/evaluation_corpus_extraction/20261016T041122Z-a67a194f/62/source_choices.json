    },
    "u016": {
      "start": 548,
      "end": 568,
      "text": "Update Nov. 13, 2025",
      "line_start": 548
    },
    "u017": {
      "start": 569,
      "end": 614,
      "text": "Command and Scripting Interpreter: PowerShell",
      "line_start": 569
    },
    "u018": {
      "start": 615,
      "end": 624,
      "text": "T1059.001",
      "line_start": 615
    },
    "u019": {
      "start": 625,
      "end": 858,
      "text": "Akira threat actors use PowerShell to execute malicious scripts and Living Off the Land Binary (LOLBin) commands for execution, persistence, credential harvesting, lateral movement, and disabling security controls to evade detection.",
      "line_start": 625
    },
    "u020": {
      "start": 859,
      "end": 1004,
      "text": "After using Ngrok to establish encrypted sessions, Akira threat actors use PowerShell and WMIC to disable services and execute malicious scripts.",
      "line_start": 859
    },
    "u021": {
      "start": 1005,
      "end": 1194,
      "text": "Akira threat actors use commercial penetration testing tools, namely Cobalt Strike, during their operations to achieve lateral movement, perform C2 procedures, and gain elevated privileges.",
      "line_start": 1005
    },
    "u022": {
      "start": 1195,
      "end": 1205,
      "text": "End Update",
      "line_start": 1195
    },
    "u023": {
      "start": 1206,
      "end": 1262,
      "text": "Command and Scripting Interpreter: Windows Command Shell",
      "line_start": 1206
    },
    "u024": {
      "start": 1263,
      "end": 1272,
      "text": "T1059.003",
      "line_start": 1263
    },
    "u025": {
      "start": 1273,
      "end": 1479,
      "text": "Akira threat actors use the Windows command shell (cmd.exe) to run batch scripts and native commands for execution, persistence, lateral movement, and to disable or manipulate security controls for evasion.",
      "line_start": 1273
    },
    "u026": {
      "start": 1480,
      "end": 1500,
      "text": "Update Nov. 13, 2025",
      "line_start": 1480
    },
    "u027": {
      "start": 1501,
      "end": 1548,
      "text": "Command and Scripting Interpreter: Visual Basic",
      "line_start": 1501
    },
    "u028": {
      "start": 1549,
      "end": 1558,
      "text": "T1059.005",
      "line_start": 1549
    },
    "u029": {
      "start": 1559,
      "end": 1724,
      "text": "Akira threat actors use VB scripts to execute malicious code, deploy ransomware payloads, or establish persistence through legitimate Windows scripting capabilities.",
      "line_start": 1559
    },
    "u030": {
      "start": 1725,
      "end": 1759,
      "text": "System Services: Service Execution",
      "line_start": 1725
    },
    "u031": {
      "start": 1760,
      "end": 1769,
      "text": "T1569.002",
      "line_start": 1760
    },
    "u032": {
      "start": 1770,
      "end": 1859,
      "text": "Akira threat actors use PSEXESVC.exe to enable remote code execution and deploy payloads.",
      "line_start": 1770
    },
    "u033": {
      "start": 1860,
      "end": 1870,
      "text": "End Update",
      "line_start": 1860
    },
    "u034": {
      "start": 1871,
      "end": 1880,
      "text": "Table 12.",
      "line_start": 1871
    },
    "u035": {
      "start": 1881,
