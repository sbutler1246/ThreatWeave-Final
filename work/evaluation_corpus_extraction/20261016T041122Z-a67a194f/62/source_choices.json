      "text": "T1190",
      "line_start": 133
    },
    "u004": {
      "start": 139,
      "end": 236,
      "text": "Akira threat actors exploit vulnerabilities in internet-facing systems to gain access to systems.",
      "line_start": 139
    },
    "u005": {
      "start": 237,
      "end": 271,
      "text": "Phishing: Spearphishing Attachment",
      "line_start": 237
    },
    "u006": {
      "start": 272,
      "end": 281,
      "text": "T1566.001",
      "line_start": 272
    },
    "u007": {
      "start": 282,
      "end": 376,
      "text": "Akira threat actors use phishing emails with malicious attachments to gain access to networks.",
      "line_start": 282
    },
    "u008": {
      "start": 377,
      "end": 405,
      "text": "Phishing: Spearphishing Link",
      "line_start": 377
    },
    "u009": {
