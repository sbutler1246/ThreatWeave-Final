      "text": "T1098",
      "line_start": 1958
    },
    "u042": {
      "start": 1964,
      "end": 2009,
      "text": "Akira threat actors modify account passwords.",
      "line_start": 1964
    },
    "u043": {
      "start": 2010,
      "end": 2039,
      "text": "Create Account: Local Account",
      "line_start": 2010
    },
    "u044": {
      "start": 2040,
      "end": 2049,
      "text": "T1136.001",
      "line_start": 2040
    },
    "u045": {
      "start": 2050,
      "end": 2172,
      "text": "Akira threat actors can create local user accounts by adding them to local admin groups to establish persistent backdoors.",
      "line_start": 2050
    },
    "u046": {
      "start": 2173,
      "end": 2183,
      "text": "End Update",
      "line_start": 2173
    },
    "u047": {
      "start": 2184,
      "end": 2214,
      "text": "Create Account: Domain Account",
      "line_start": 2184
    },
    "u048": {
      "start": 2215,
      "end": 2224,
      "text": "T1136.002",
      "line_start": 2215
    },
    "u049": {
      "start": 2225,
      "end": 2355,
      "text": "Akira threat actors attempt to abuse the functions of domain controllers by creating new domain accounts to establish persistence.",
      "line_start": 2225
    }
