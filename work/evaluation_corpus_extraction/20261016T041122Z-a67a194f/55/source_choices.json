  "units": {
    "u001": {
      "start": 0,
      "end": 78,
      "text": "FTP tools that can be used for data exfiltration or remote management [T1048].",
      "line_start": 0
    },
    "u002": {
      "start": 79,
      "end": 91,
      "text": "Vssadmin.exe",
      "line_start": 79
    },
    "u003": {
      "start": 92,
      "end": 170,
      "text": "A Windows executable used by Akira threat actors to delete VSS copies [T1490].",
      "line_start": 92
    },
    "u004": {
      "start": 171,
      "end": 179,
      "text": "Level.io",
      "line_start": 171
    },
    "u005": {
      "start": 180,
      "end": 257,
      "text": "A remote monitoring and management platform leveraged by Akira threat actors.",
      "line_start": 180
    },
    "u006": {
      "start": 258,
      "end": 268,
      "text": "HeartCrypt",
      "line_start": 258
    },
    "u007": {
      "start": 269,
      "end": 363,
      "text": "A packer-as-a-service obfuscation tool used by Akira threat actors to hinder analysis [T1027].",
      "line_start": 269
    },
    "u008": {
      "start": 364,
      "end": 368,
      "text": "MEGA",
      "line_start": 364
    },
    "u009": {
      "start": 369,
      "end": 461,
      "text": "A cloud storage utility used by Akira threat actors as the destination for exfiltrated data.",
      "line_start": 369
    },
    "u010": {
      "start": 462,
      "end": 469,
      "text": "POORTRY",
      "line_start": 462
    },
    "u011": {
      "start": 470,
      "end": 525,
      "text": "Malware written as a signed vulnerable Windows deriver.",
      "line_start": 470
    },
    "u012": {
      "start": 526,
      "end": 636,
      "text": "Akira threat actors used the malware to implement the Bring Your Own Vulnerable Driver (BYOVD) tactic [T1068].",
      "line_start": 470
    },
    "u013": {
      "start": 637,
      "end": 646,
      "text": "STONESTOP",
      "line_start": 637
    },
    "u014": {
      "start": 647,
      "end": 729,
      "text": "Malware that Akira threat actors used as the loader/installer for POORTRY [T1105].",
      "line_start": 647
    },
    "u015": {
      "start": 730,
      "end": 746,
      "text": "SharpDomainSpray",
      "line_start": 730
    },
    "u016": {
      "start": 747,
      "end": 800,
      "text": "A password spraying tool used by Akira threat actors.",
      "line_start": 747
    },
    "u017": {
      "start": 801,
      "end": 808,
      "text": "OpenSSH",
      "line_start": 801
    },
    "u018": {
      "start": 809,
      "end": 898,
      "text": "An open source SSH tool used by Akira threat actors for cross-platform remote management.",
      "line_start": 809
    },
    "u019": {
      "start": 899,
      "end": 910,
      "text": "CLOUDFLARED",
      "line_start": 899
    },
    "u020": {
      "start": 911,
      "end": 1086,
      "text": "A legitimate, publicly available command-line client for Cloudflare Tunnel, a tunneling daemon that serves as a proxy for traffic from the Cloudflare network to the endpoints.",
      "line_start": 911
    },
    "u021": {
      "start": 1087,
      "end": 1095,
      "text": "IMPACKET",
      "line_start": 1087
    },
    "u022": {
      "start": 1096,
      "end": 1170,
      "text": "A Python library that allows users to work with various network protocols.",
      "line_start": 1096
    },
    "u023": {
      "start": 1171,
      "end": 1181,
      "text": "End Update",
      "line_start": 1171
    },
    "u024": {
      "start": 1182,
      "end": 1206,
      "text": "Indicators of Compromise",
      "line_start": 1182
    },
    "u025": {
      "start": 1207,
      "end": 1278,
      "text": "Disclaimer: These IOCs were observed between June 2023 and August 2025.",
      "line_start": 1207
    },
    "u026": {
      "start": 1279,
      "end": 1394,
      "text": "The authoring organizations recommend vetting or investigating these IOCs prior to taking action, such as blocking.",
      "line_start": 1207
    },
    "u027": {
      "start": 1395,
      "end": 1449,
      "text": "See Table 2 through Table 9 for Akira ransomware IOCs.",
      "line_start": 1395
    },
