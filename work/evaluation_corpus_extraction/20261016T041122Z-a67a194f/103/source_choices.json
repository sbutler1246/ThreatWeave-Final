    },
    "u045": {
      "start": 1040,
      "end": 1071,
      "text": "Indicators of Compromise (IOCs)",
      "line_start": 1040
    },
    "u046": {
      "start": 1072,
      "end": 1157,
      "text": "The IOCs and malware characteristics outlined below were derived from field analysis.",
      "line_start": 1072
    },
    "u047": {
      "start": 1158,
      "end": 1209,
      "text": "The following samples are current as of March 2023.",
      "line_start": 1072
    },
    "u048": {
      "start": 1210,
      "end": 1232,
      "text": "LockBit 3.0 Black Icon",
      "line_start": 1210
    },
    "u049": {
      "start": 1233,
      "end": 1254,
      "text": "LockBit 3.0 Wallpaper",
      "line_start": 1233
    },
    "u050": {
      "start": 1255,
      "end": 1286,
      "text": "LockBit Command Line Parameters",
      "line_start": 1255
    },
    "u051": {
      "start": 1287,
      "end": 1305,
      "text": "LockBit Parameters",
      "line_start": 1287
    },
    "u052": {
      "start": 1306,
      "end": 1317,
      "text": "Description",
      "line_start": 1306
    },
    "u053": {
      "start": 1318,
      "end": 1322,
      "text": "-del",
      "line_start": 1318
    },
    "u054": {
      "start": 1323,
      "end": 1335,
      "text": "Self-delete.",
      "line_start": 1323
    },
    "u055": {
      "start": 1336,
      "end": 1341,
      "text": "-gdel",
      "line_start": 1336
    },
    "u056": {
      "start": 1342,
      "end": 1382,
      "text": "Remove LockBit 3.0 group policy changes.",
      "line_start": 1342
    },
    "u057": {
      "start": 1383,
      "end": 1388,
      "text": "-gspd",
      "line_start": 1383
    },
    "u058": {
      "start": 1389,
      "end": 1423,
      "text": "Spread laterally via group policy.",
      "line_start": 1389
    },
    "u059": {
      "start": 1424,
      "end": 1450,
      "text": "-pass (32 character value)",
      "line_start": 1424
    },
    "u060": {
      "start": 1451,
      "end": 1498,
      "text": "(Required) Password used to launch LockBit 3.0.",
      "line_start": 1451
    },
    "u061": {
      "start": 1499,
      "end": 1519,
      "text": "-path (File or path)",
      "line_start": 1499
    },
    "u062": {
      "start": 1520,
      "end": 1558,
      "text": "Only encrypts provided file or folder.",
      "line_start": 1520
    },
    "u063": {
      "start": 1559,
      "end": 1564,
      "text": "-psex",
      "line_start": 1559
    },
    "u064": {
      "start": 1565,
      "end": 1599,
      "text": "Spread laterally via admin shares.",
      "line_start": 1565
    },
    "u065": {
      "start": 1600,
      "end": 1605,
      "text": "-safe",
      "line_start": 1600
    },
    "u066": {
      "start": 1606,
      "end": 1633,
      "text": "Reboot host into Safe Mode.",
      "line_start": 1606
    },
    "u067": {
      "start": 1634,
      "end": 1639,
      "text": "-wall",
      "line_start": 1634
    },
    "u068": {
      "start": 1640,
      "end": 1706,
      "text": "Sets LockBit 3.0 Wallpaper and prints out LockBit 3.0 ransom note.",
      "line_start": 1640
    },
    "u069": {
      "start": 1707,
      "end": 1746,
      "text": "Mutual Exclusion Object (Mutex) Created",
      "line_start": 1707
    },
    "u070": {
      "start": 1747,
      "end": 1831,
      "text": "When executed, LockBit 3.0 will create the mutex, Global\\<MD4 hash of machine GUID>,",
      "line_start": 1747
    },
    "u071": {
      "start": 1832,
      "end": 1946,
      "text": "and check to see if this mutex has already been created to avoid running more than one instance of the ransomware.",
      "line_start": 1832
    },
    "u072": {
      "start": 1947,
      "end": 1984,
      "text": "UAC Bypass via Elevated COM Interface",
      "line_start": 1947
    }
