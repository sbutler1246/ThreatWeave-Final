  "units": {
    "u001": {
      "start": 1,
      "end": 111,
      "text": "reports, intellectual property, accounting, law actions and complaints, personal files and so on and so forth.",
      "line_start": 0
    },
    "u002": {
      "start": 112,
      "end": 159,
      "text": "We are able to solve this problem in one touch.",
      "line_start": 112
    },
    "u003": {
      "start": 160,
      "end": 275,
      "text": "We (BlackSuit) are ready to give you an opportunity to get all the things back if you agree to make a deal with us.",
      "line_start": 160
    },
    "u004": {
      "start": 276,
      "end": 415,
      "text": "You have a chance to get rid of all possible financial, legal, insurance and many others risks and problems for a quite small compensation.",
      "line_start": 276
    },
    "u005": {
      "start": 416,
      "end": 461,
      "text": "You can have a safety review of your systems.",
      "line_start": 416
    },
    "u006": {
      "start": 462,
      "end": 552,
      "text": "All your files will be decrypted, your data will be reset, your systems will stay in safe.",
      "line_start": 462
    },
    "u007": {
      "start": 553,
      "end": 599,
      "text": "Contact us through TOR browser using the link:",
      "line_start": 553
    },
    "u008": {
      "start": 600,
      "end": 635,
      "text": "MITRE ATT&CK Tactics and Techniques",
      "line_start": 600
    },
    "u009": {
      "start": 636,
      "end": 808,
      "text": "See Table 18 through Table 23 for all referenced threat actor tactics and techniques in this advisory, as well as corresponding detection and/or mitigation recommendations.",
      "line_start": 636
    },
    "u010": {
      "start": 809,
      "end": 865,
      "text": "For additional mitigations, see the Mitigations section.",
      "line_start": 636
    },
    "u011": {
      "start": 866,
      "end": 935,
      "text": "Table 18: BlackSuit Actors ATT&CK Techniques for Resource Development",
