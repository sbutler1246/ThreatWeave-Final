    {
      "citation_id": "E1",
      "doc_id": "AA24-109A",
      "chunk_id": "AA24-109A:evaluation:llama500:10612:12792",
      "source_url": "https://www.cisa.gov/news-events/cybersecurity-advisories/aa24-109a",
      "text": "The authoring organizations observed Akira threat actors establishing command and control (C2) communications by using tunneling utilities, such as Ngrok [T1572]",
      "start": 11788,
      "end": 11949,
      "source_kind": "cisa"
    },
    {
      "citation_id": "E2",
      "doc_id": "AA24-109A",
      "chunk_id": "AA24-109A:evaluation:llama500:10612:12792",
      "source_url": "https://www.cisa.gov/news-events/cybersecurity-advisories/aa24-109a",
      "text": "#StopRansomware: Akira Ransomware",
      "start": 23,
      "end": 56,
      "source_kind": "cisa"
    },
    {
      "citation_id": "E3",
      "doc_id": "AA24-109A",
