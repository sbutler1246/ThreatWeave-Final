      "source_kind": "cisa"
    },
    {
      "citation_id": "E4",
      "doc_id": "attack:17.1:relationship--17639fa3-3f77-4481-b24f-9df82fcbf324",
      "chunk_id": "attack:17.1:relationship--17639fa3-3f77-4481-b24f-9df82fcbf324:description",
      "source_url": "https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack-17.1.json",
      "text": "ATT&CK release: 17.1\nTechnique: Protocol Tunneling (T1572)\nMitigation: Network Intrusion Prevention (M1031)",
      "start": 0,
      "end": 107,
      "source_kind": "attack"
    },
    {
      "citation_id": "E5",
      "doc_id": "attack:17.1:relationship--17639fa3-3f77-4481-b24f-9df82fcbf324",
      "chunk_id": "attack:17.1:relationship--17639fa3-3f77-4481-b24f-9df82fcbf324:description",
      "source_url": "https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack-17.1.json",
      "text": "Network intrusion detection and prevention systems that use network signatures to identify traffic for specific adversary malware can be used to mitigate activity at the network level. ",
      "start": 285,
      "end": 470,
      "source_kind": "attack"
    },
    {
      "citation_id": "E6",
      "doc_id": "AA24-109A",
      "chunk_id": "AA24-109A:evaluation:llama500:12528:14948",
      "source_url": "https://www.cisa.gov/news-events/cybersecurity-advisories/aa24-109a",
      "text": "In some instances, Akira threat actors use Ngrok to create secure tunnels for data exfiltration [T1090].",
      "start": 12687,
      "end": 12791,
      "source_kind": "cisa"
    },
    {
      "citation_id": "E7",
      "doc_id": "AA24-109A",
      "chunk_id": "AA24-109A:evaluation:llama500:14693:17032",
      "source_url": "https://www.cisa.gov/news-events/cybersecurity-advisories/aa24-109a",
      "text": "To further inhibit system recovery and impede forensic analysis, Akira’s encryptor (w.exe) uses PowerShell commands to delete Volume Shadow Copy Service (VSS) copies on Windows systems [T1490].",
      "start": 14754,
      "end": 14947,
      "source_kind": "cisa"
    },
    {
      "citation_id": "E8",
      "doc_id": "attack:17.1:relationship--d62f97e9-2b94-44d9-88db-99f849a804ec",
      "chunk_id": "attack:17.1:relationship--d62f97e9-2b94-44d9-88db-99f849a804ec:description",
      "source_url": "https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack-17.1.json",
      "text": "ATT&CK release: 17.1\nTechnique: Inhibit System Recovery (T1490)\nMitigation: User Account Management (M1018)",
      "start": 0,
      "end": 107,
      "source_kind": "attack"
    },
    {
      "citation_id": "E9",
      "doc_id": "attack:17.1:relationship--d62f97e9-2b94-44d9-88db-99f849a804ec",
      "chunk_id": "attack:17.1:relationship--d62f97e9-2b94-44d9-88db-99f849a804ec:description",
      "source_url": "https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack-17.1.json",
      "text": "Limit the user accounts that have access to backups to only those required. In AWS environments, consider using Service Control Policies to restrict API calls to delete backups, snapshots, and images. ",
      "start": 285,
      "end": 486,
      "source_kind": "attack"
    },
    {
      "citation_id": "E10",
      "doc_id": "attack:17.1:relationship--0927eb00-4a08-4ed1-8678-84d6e1e87b98",
      "chunk_id": "attack:17.1:relationship--0927eb00-4a08-4ed1-8678-84d6e1e87b98:description",
      "source_url": "https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack-17.1.json",
      "text": "ATT&CK release: 17.1\nTechnique: Protocol Tunneling (T1572)\nMitigation: Filter Network Traffic (M1037)",
      "start": 0,
      "end": 101,
      "source_kind": "attack"
    },
    {
      "citation_id": "E11",
      "doc_id": "attack:17.1:relationship--0927eb00-4a08-4ed1-8678-84d6e1e87b98",
      "chunk_id": "attack:17.1:relationship--0927eb00-4a08-4ed1-8678-84d6e1e87b98:description",
      "source_url": "https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack-17.1.json",
      "text": "Consider filtering network traffic to untrusted or known bad domains and resources. ",
      "start": 279,
      "end": 363,
      "source_kind": "attack"
    },
    {
      "citation_id": "E12",
      "doc_id": "attack:17.1:relationship--c4cd9acb-aaea-4b77-890e-f153a58623a4",
      "chunk_id": "attack:17.1:relationship--c4cd9acb-aaea-4b77-890e-f153a58623a4:description",
      "source_url": "https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack-17.1.json",
      "text": "ATT&CK release: 17.1\nTechnique: Inhibit System Recovery (T1490)\nMitigation: Operating System Configuration (M1028)",
      "start": 0,
      "end": 114,
      "source_kind": "attack"
    },
    {
      "citation_id": "E13",
      "doc_id": "attack:17.1:relationship--c4cd9acb-aaea-4b77-890e-f153a58623a4",
      "chunk_id": "attack:17.1:relationship--c4cd9acb-aaea-4b77-890e-f153a58623a4:description",
      "source_url": "https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack-17.1.json",
      "text": "Consider technical controls to prevent the disabling of services or deletion of files involved in system recovery. Additionally, ensure that WinRE is enabled using the following command: <code>reagentc /enable</code>.(Citation: reagentc_cmd)",
      "start": 292,
      "end": 533,
      "source_kind": "attack"
    },
    {
      "citation_id": "E14",
      "doc_id": "attack:17.1:relationship--9104be87-33ad-4a35-96db-3e2ed5c17f46",
      "chunk_id": "attack:17.1:relationship--9104be87-33ad-4a35-96db-3e2ed5c17f46:description",
      "source_url": "https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack-17.1.json",
      "text": "ATT&CK release: 17.1\nTechnique: Inhibit System Recovery (T1490)\nMitigation: Execution Prevention (M1038)",
      "start": 0,
      "end": 104,
      "source_kind": "attack"
    },
    {
      "citation_id": "E15",
      "doc_id": "attack:17.1:relationship--9104be87-33ad-4a35-96db-3e2ed5c17f46",
      "chunk_id": "attack:17.1:relationship--9104be87-33ad-4a35-96db-3e2ed5c17f46:description",
      "source_url": "https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack-17.1.json",
      "text": "Consider using application control configured to block execution of utilities such as `diskshadow.exe` that may not be required for a given system or network to prevent potential misuse by adversaries. ",
      "start": 282,
      "end": 484,
      "source_kind": "attack"
    }
